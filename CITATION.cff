title: "China PensionSIM: An open dynamic microsimulation model of China's multi-pillar pension system"
version: 1.0.0
date-released: 2026-11-22
license: Apache-2.0
type: software
repository-code: "https://github.com/huangchengcheng1656-ship-it/china-pensionsim"
authors:
  - family-names: Wang
    given-names: Ping
    affiliation: "Taizhou Vocational and Technical College"
  - family-names: Huang
    given-names: Chengcheng
    affiliation: "Weifang Ocean University of Science and Technology"
